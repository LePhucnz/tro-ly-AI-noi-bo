# ==============================================================================
# Git Ignore - Trợ lý AI Nội bộ & Sàng lọc CV Tuyển dụng
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
ENV*/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
coverage.xml
*.junit.xml

# Logs & Temporary files
*.log
tmp/
temp/
*.tmp
logs/
temp_cv/
uploads/

# Streamlit Cache & Telemetry
.streamlit/
*.streamlit

# IDEs & Code Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.directory

# Environment Variables & Sensitive Credentials
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Vector Store, Database & Local Storage
data/
chroma_db/
*.sqlite3
*.db
.user_uploaded/
