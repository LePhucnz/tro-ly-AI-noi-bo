# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG TRỢ LÝ AI NỘI BỘ (RAG BACKEND)
# Sao chép tệp này thành .env và điền các giá trị mong muốn
# ==============================================================================

# --- Thông tin Dịch vụ & Môi trường ---
APP_NAME="Trợ lý AI Nội bộ - RAG & Document Ingestion Core"
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# --- Cấu hình ChromaDB (Persistent Storage) ---
# Thư mục lưu trữ vector database trên ổ đĩa cục bộ
CHROMA_PERSIST_DIR=./data/chroma_db
# Tên collection mặc định chứa các chunks tài liệu
CHROMA_COLLECTION_NAME=internal_knowledge_base

# --- Cấu hình Mô hình Embedding ---
# Nhà cung cấp: 'huggingface' (cục bộ/offline) hoặc 'openai'
EMBEDDING_PROVIDER=huggingface
# Tên model embedding (Sentence Transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- Cấu hình Chia tách văn bản (RecursiveCharacterTextSplitter) ---
# Kích thước ký tự tối đa của một đoạn (chunk)
CHUNK_SIZE=1000
# Số ký tự gối đầu giữa các đoạn liền kề để bảo toàn ngữ cảnh
CHUNK_OVERLAP=200

# --- Cấu hình Advanced Retriever ---
# Chiến lược mặc định: 'similarity', 'mmr', hoặc 'similarity_score_threshold'
DEFAULT_RETRIEVER_STRATEGY=similarity
# Số lượng tài liệu trích xuất tối đa trả về cho mỗi truy vấn
DEFAULT_TOP_K=4
# Ngưỡng điểm tương đồng tối thiểu cho chiến lược similarity_score_threshold (0.0 - 1.0)
DEFAULT_SCORE_THRESHOLD=0.5
# Hệ số cân bằng giữa độ liên quan và đa dạng cho thuật toán MMR (0.0 - 1.0)
MMR_LAMBDA_MULT=0.7
# Số lượng ứng viên khởi tạo ban đầu trước khi lọc MMR
MMR_FETCH_K=20

# --- Cấu hình LLM & Chống ảo giác (Anti-Hallucination) ---
# Nhà cung cấp: 'mock', 'openai', 'gemini'
LLM_PROVIDER=mock
LLM_MODEL_NAME=gpt-4o-mini
# Nhiệt độ sáng tạo (0.0 giúp câu trả lời chuẩn xác, hạn chế tối đa ảo giác)
LLM_TEMPERATURE=0.0

# --- Khóa API (Tùy chọn khi kích hoạt LLM bên ngoài) ---
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
